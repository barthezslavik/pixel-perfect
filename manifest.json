{
  "name": "Pixel Perfect",
  "manifest_version": 3,
  "version": "2.0.0",
  "description": "Complete pixel-perfect toolkit: spacing, dimensions, fonts, grid, colors, and effects visualization",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Pixel Perfect"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "css": ["spacing-grid.css"],
      "run_at": "document_idle"
    }
  ]
}
